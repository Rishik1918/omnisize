{
  "name": "omnisize",
  "private": true,
  "version": "3.0.0",
  "author": "Rishik",
  "description": "Omnisize - Document & PDF Suite by Rishik",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "electron electron/main.cjs",
    "desktop": "vite build && electron electron/main.cjs",
    "dist:win": "electron-builder --win portable",
    "dist:dir": "electron-builder --win dir",
    "dist:installer": "electron-builder --win nsis"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@types/jszip": "^3.4.0",
    "@types/node-forge": "^1.3.14",
    "docx": "^9.7.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.12.2",
    "node-forge": "^1.4.0",
    "onnxruntime-web": "^1.30.0",
    "pako": "^2.1.0",
    "pdf-lib": "^1.17.1",
    "pdfstudio": "^0.4.0",
    "ppu-paddle-ocr": "^6.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/pako": "^2.0.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.omnisize.app",
    "productName": "Omnisize",
    "copyright": "Copyright © 2026 Rishik",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Editor",
        "icon": "electron/icon.ico"
      },
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "webp"
        ],
        "name": "Image Document",
        "role": "Viewer",
        "icon": "electron/icon.ico"
      },
      {
        "ext": [
          "docx",
          "doc"
        ],
        "name": "Word Document",
        "role": "Editor",
        "icon": "electron/icon.ico"
      },
      {
        "ext": [
          "xlsx",
          "xls"
        ],
        "name": "Excel Spreadsheet",
        "role": "Viewer",
        "icon": "electron/icon.ico"
      },
      {
        "ext": "zip",
        "name": "ZIP Archive",
        "role": "Viewer",
        "icon": "electron/icon.ico"
      }
    ],
    "nsis": {
      "include": "electron/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Omnisize",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Omnisize (by Rishik)",
      "warningsAsErrors": false,
      "differentialPackage": false
    }
  }
}
